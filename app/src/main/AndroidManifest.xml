<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BLE provisioning (Android 12+ / API 31+). usesPermissionFlags="neverForLocation"
         declares we don't derive location from BLE scans, which spares the user a
         location-permission prompt on 12+. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- BLE provisioning (Android 11 and below). ACCESS_FINE_LOCATION is required
         for BLE scanning to return ANY results pre-12 — without it the scan
         silently succeeds and reports zero devices. Location Services must also
         be switched on at the OS level on those versions. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- Badge control channel. INTERNET is required to bind the TCP 5001 listener
         even though nothing here ever leaves the factory LAN — Android gates all
         socket use behind it. NsdManager holds its own multicast lock for the
         mDNS advertisement, so CHANGE_WIFI_MULTICAST_STATE is not needed. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Supervisor push-to-talk: the phone mic is captured and streamed to a
         badge over UDP 5002. Receiving and playing badge audio needs no
         permission; only capture does. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <application
        android:name=".VikoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Viko">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Viko"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>