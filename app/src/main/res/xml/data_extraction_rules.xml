<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 12 and higher.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- The factory Wi-Fi password stays on this phone: not in the cloud, and not
         copied to a new phone either. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="factory_wifi.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="factory_wifi.xml"/>
    </device-transfer>
</data-extraction-rules>
